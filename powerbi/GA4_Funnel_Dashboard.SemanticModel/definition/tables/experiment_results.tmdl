table experiment_results
	lineageTag: e456fde1-9436-42a6-ba2a-96416e721438

	measure 'Test Decision' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN sc & "  ·  " & CALCULATE(MAX(experiment_results[decision]), experiment_results[scenario] = sc)
		displayFolder: Experiment
		lineageTag: 7ff7ce1b-9944-4454-9ea0-9a3af70faa01

	measure 'Primary Lift' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(MAX(experiment_results[relative_lift]), experiment_results[role] = "primary", experiment_results[scenario] = sc)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: 32fe0afd-4514-4710-b1f3-17877a873a62

	measure 'Primary p-value' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(MAX(experiment_results[p_value]), experiment_results[role] = "primary", experiment_results[scenario] = sc)
		formatString: 0.000
		displayFolder: Experiment
		lineageTag: dc2538ff-9ece-4332-80b0-e3b3770cbfd7

	measure 'Primary P(Variant Better)' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(MAX(experiment_results[prob_variant_better]), experiment_results[role] = "primary", experiment_results[scenario] = sc)
		formatString: 0.0%
		displayFolder: Experiment
		lineageTag: 9a1d52e6-fa35-45ce-9258-fa2c303bfd9c

	measure 'Guardrail Lift' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(MAX(experiment_results[relative_lift]), experiment_results[role] = "guardrail", experiment_results[scenario] = sc)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: f7735d48-0d57-4885-880a-74cdfc99d79f

	measure 'SRM p-value' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(MAX(experiment_results[srm_p_value]), experiment_results[scenario] = sc)
		formatString: 0.000
		displayFolder: Experiment
		lineageTag: 649fd9bf-7540-45fc-81f0-b685f45d84af

	measure 'Control Rate' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(AVERAGE(experiment_results[control_rate]), experiment_results[scenario] = sc)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Experiment
		lineageTag: 75b5539d-08c5-483c-8c73-e3e096e76896

	measure 'Variant Rate' =
			VAR sc = SELECTEDVALUE(experiment_results[scenario], "A_true_lift")
			RETURN CALCULATE(AVERAGE(experiment_results[variant_rate]), experiment_results[scenario] = sc)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Experiment
		lineageTag: 2b73d2fe-0f9f-41a1-9bf7-45e7a70cf17e

	column scenario
