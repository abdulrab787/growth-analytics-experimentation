	partition experiment_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "experiment_results.csv"), [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scenario", type text}, {"metric", type text}, {"role", type text}, {"control_rate", type number}, {"variant_rate", type number}, {"relative_lift", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"prob_variant_better", type number}, {"decision", type text}, {"srm_p_value", type number}, {"control_users", Int64.Type}, {"variant_users", Int64.Type}}, "en-US")
				in
				    Typed

